generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model ProductCategory {
  categoryId  String    @id @default(cuid())
  name        String    @unique
  products    Product[]
  description String?
}

model Product {
  id              String          @id @default(cuid())
  slug            String?
  name            String
  price           Int
  stock           Int
  description     String?
  isAvailable     Boolean         @default(true)
  categoryId      String
  orderItems      OrderItem[]
  productCategory ProductCategory @relation(fields: [categoryId], references: [categoryId])
}

model OrderItem {
  id               String  @id @default(cuid())
  quantity         Int
  orderId          String
  productId        String
  preparedQuantity Int     @default(0)
  priceSnapshot    Int
  subtotal         Int
  order            Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product          Product @relation(fields: [productId], references: [id])
}

model Order {
  id            String        @id @default(cuid())
  slug          String?
  customerName  String
  totalAmount   Int
  status        OrderStatus   @default(PENDING)
  orderType     OrderType     @default(TAKEAWAY)
  paymentStatus PaymentStatus @default(UNPAID)
  pickupDate    DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  orderItems    OrderItem[]
}

enum OrderStatus {
  PENDING
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
}

enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
}
