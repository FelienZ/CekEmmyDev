generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model ProductCategory {
  categoryId  String  @id @default(cuid())
  // slug        String    @unique
  name        String  @unique
  description String?

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model TransactionCategory {
  categoryId  String  @id @default(cuid())
  name        String  @unique
  slug        String  @unique
  description String?
  isActive    Boolean @default(true)

  type         TransactionType
  transactions Transaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model Product {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String  @unique
  price       Int     @default(0)
  stock       Int     @default(0)
  description String?
  isAvailable Boolean @default(true)
  categoryId  String

  orderItems      OrderItem[]
  productCategory ProductCategory @relation(fields: [categoryId], references: [categoryId])

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model OrderItem {
  id               String @id @default(cuid())
  quantity         Int
  preparedQuantity Int    @default(0)
  priceSnapshot    Int
  subtotal         Int
  orderId          String
  productId        String

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
}

model Order {
  id            String        @id @default(cuid())
  customerName  String
  totalAmount   Int
  paidAmount    Int           @default(0)
  status        OrderStatus   @default(PENDING)
  orderType     OrderType     @default(TAKEAWAY)
  paymentStatus PaymentStatus @default(UNPAID)
  pickupDate    DateTime?

  orderItems  OrderItem[]
  transaction Transaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model Transaction {
  id String @id @default(cuid())

  amount          Decimal
  description     String?
  transactionDate DateTime          @default(now())
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  source          TransactionSource

  categoryId String
  orderId    String?

  order               Order?              @relation(fields: [orderId], references: [id])
  transactionCategory TransactionCategory @relation(fields: [categoryId], references: [categoryId])
}

// tipe static, jarang berubah atau fixed.
enum OrderStatus {
  PENDING
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
  PARTIAL
}

enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum TransactionSource {
  MANUAL
  ORDER
}
